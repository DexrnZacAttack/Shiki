    <ItemGroup>
      <Folder Include="Util\Serialization\" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Remove="Result\.ErrorCodeResult_NEW.cs" />
      <None Include="Result\.ErrorCodeResult_NEW.cs" />
