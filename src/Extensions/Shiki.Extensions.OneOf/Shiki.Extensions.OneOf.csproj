<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Shiki extensions for OneOf</Description>
        <Copyright>DexrnZacAttack</Copyright>
        <Company>DexrnZacAttack</Company>
        <Authors>DexrnZacAttack</Authors>
        <PackageProjectUrl>https://git.dexrn.me/Dexrn/Shiki/</PackageProjectUrl>
        <PackageLicenseUrl>https://git.dexrn.me/Dexrn/Shiki/src/branch/main/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://git.dexrn.me/Dexrn/Shiki/</RepositoryUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <Version>1.0.0</Version>
        <PackageReleaseNotes>- Initial creation
- Added `IResultExtensions.SuccessOrFailure()`, which converts an `IResult` to a `OneOf&lt;TSuccess,TFailure&gt;`</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="OneOf" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Shiki.Common\Shiki.Common.csproj" />
    </ItemGroup>

</Project>
